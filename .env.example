# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Locally: uv run --env-file .env <command>
# No secrets belong in this file: the API key is read from SSM Parameter Store.

# Sandbox: https://sandbox-api.va.gov/services/va_facilities/v1
# Production: https://api.va.gov/services/va_facilities/v1
VA_API_BASE_URL=https://sandbox-api.va.gov/services/va_facilities/v1

# SSM parameter holding the VA API key (see README: AWS infrastructure)
VA_API_KEY_SSM_PARAMETER=/va-facilities-report/sandbox/api-key

# Where raw/, processed/ and metadata/ go: the S3 data lake
# (bucket name: `terraform output bucket_name`), or a local folder, e.g. data
DATA_DIR=s3://va-facilities-report-<account-id>

# AWS CLI profile used for S3 and SSM (credentials live in ~/.aws, not here)
AWS_PROFILE=pipeline-va-facilities-report
