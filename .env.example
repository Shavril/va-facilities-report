# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Locally: uv run --env-file .env <command>
# On AWS: values come from SSM Parameter Store (/va-facilities-report/<env>/...).

# VA Facilities API key (sent in the "apikey" header)
VA_API_KEY=

# Sandbox: https://sandbox-api.va.gov/services/va_facilities/v1
# Production: https://api.va.gov/services/va_facilities/v1
VA_API_BASE_URL=https://sandbox-api.va.gov/services/va_facilities/v1

# Storage root for raw/, processed/ and metadata/ (default: data/)
DATA_DIR=data
